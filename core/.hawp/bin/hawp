#!/bin/bash
# HAWP CLI entry point — delegates to the Go binary.
#
# The TypeScript fallback (npm/tsx) has been removed. All commands are now
# handled by the Go binary distributed with each HAWP release.
#
# Install or update the binary:
#   hawp update              # update to latest release
#   hawp update --check      # check for a newer release without installing
#
# Or download manually from:
#   https://github.com/sentzunhat/human-ai-workflow-protocol/releases

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$SCRIPT_DIR/hawp-bin"

# Prefer a sibling Go binary named hawp-bin, then fall back to PATH.
if [ ! -x "$BIN" ]; then
  if command -v hawp >/dev/null 2>&1; then
    BIN="$(command -v hawp)"
  else
    echo "hawp: Go binary not found." >&2
    echo "Download from https://github.com/sentzunhat/human-ai-workflow-protocol/releases" >&2
    echo "or run: hawp update" >&2
    exit 1
  fi
fi

exec "$BIN" "$@"
